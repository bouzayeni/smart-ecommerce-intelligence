# Copy to .env and replace every "change-me" value. Never commit .env.

# --- PostgreSQL (docker compose) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=olist_dw
# Superuser: used only by the container to run init scripts.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser

# Owner of raw/staging/intermediate/marts/ml schemas (ETL, dbt, ML training).
ETL_DB_USER=etl_user
ETL_DB_PASSWORD=change-me-etl

# Read-only on marts + ml, 15s statement timeout (BI tools, AI assistant).
ANALYTICS_DB_USER=analytics_ro
ANALYTICS_DB_PASSWORD=change-me-analytics

# Backend app: read marts + ml, read/write app schema (users, tokens, audit log).
APP_DB_USER=app_user
APP_DB_PASSWORD=change-me-app

# --- Data ---
# DATA_DIR=./data

# --- Backend auth (Phase 9) ---
JWT_SECRET_KEY=change-me-generate-with-python-secrets-token-urlsafe-64
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Per client IP. Use a Redis-backed limiter when running several API workers.
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_AUTH=10/minute
# Schema for users/tokens/audit (tests override it with an isolated schema).
APP_SCHEMA=app

# --- AI assistant (Phase 11) ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Empty key = tools-only mode (the /assistant page shows the tool catalog).
ASSISTANT_EFFORT=medium
ASSISTANT_MAX_ITERATIONS=6
ASSISTANT_TIMEOUT_S=120
RATE_LIMIT_ASSISTANT=20/minute

# --- MLflow (Phase 6+) ---
# Empty = local SQLite store at mlflow/mlflow.db (runs, metrics, model registry).
MLFLOW_TRACKING_URI=
# Containers only: exported champion models (python -m ml.export_serving_models).
# SERVING_MODELS_DIR=models/serving
