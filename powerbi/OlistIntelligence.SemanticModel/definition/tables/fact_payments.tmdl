table fact_payments
	lineageTag: a636edff-829d-58ed-99a4-59c5a12f302e

	/// Σ payment_value of revenue orders in the window (separate from GMV, BR-04).
	measure 'Payment Value (BRL)' = ```
			CALCULATE (
			    SUM ( fact_payments[payment_value] ),
			    fact_payments[is_revenue_order] = TRUE (),
			    fact_payments[is_in_analysis_window] = TRUE ()
			)
			```
		formatString: #,0.00
		displayFolder: Payments
		lineageTag: 4f3699f9-b33a-5866-9bee-850276f72d3f

	/// Mean installments per payment line, revenue orders in the window.
	measure 'Avg Installments' = ```
			CALCULATE (
			    AVERAGE ( fact_payments[payment_installments] ),
			    fact_payments[is_revenue_order] = TRUE (),
			    fact_payments[is_in_analysis_window] = TRUE ()
			)
			```
		formatString: 0.00
		displayFolder: Payments
		lineageTag: 2e8924f5-9fb3-50a5-a3e6-dfd1b5893eda

