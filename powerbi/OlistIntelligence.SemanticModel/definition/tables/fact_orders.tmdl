table fact_orders
	lineageTag: 28a1331a-9632-5b25-bf7c-73b19312a680

	/// Σ(price + freight) of revenue orders in the analysis window.
	measure 'GMV (BRL)' = ```
			CALCULATE (
			    SUM ( fact_orders[gmv] ),
			    fact_orders[is_revenue_order] = TRUE (),
			    fact_orders[is_in_analysis_window] = TRUE ()
			)
			```
		formatString: #,0.00
		displayFolder: Sales
		lineageTag: b04356b7-c7e1-5882-9a92-58c04de1f9a9

	/// Orders with a revenue status in the analysis window.
	measure 'Revenue Orders' = ```
			CALCULATE (
			    COUNTROWS ( fact_orders ),
			    fact_orders[is_revenue_order] = TRUE (),
			    fact_orders[is_in_analysis_window] = TRUE ()
			)
			```
		formatString: #,0
		displayFolder: Sales
		lineageTag: f64e0b7f-9ef1-5a7e-9235-c7b725f72414

	/// GMV / revenue orders.
	measure 'Average Order Value (BRL)' = DIVIDE ( [GMV (BRL)], [Revenue Orders] )
		formatString: #,0.00
		displayFolder: Sales
		lineageTag: f1f998c7-602b-5198-afae-c27b3c018d03

	/// Σ price (GMV without freight).
	measure 'Merchandise Value (BRL)' = ```
			CALCULATE (
			    SUM ( fact_orders[price_total] ),
			    fact_orders[is_revenue_order] = TRUE (),
			    fact_orders[is_in_analysis_window] = TRUE ()
			)
			```
		formatString: #,0.00
		displayFolder: Sales
		lineageTag: 8e3b1ee7-6a2f-5250-b37c-1b223df79858

	/// GMV of the previous calendar month (time intelligence on dim_date).
	measure 'GMV Previous Month (BRL)' = CALCULATE ( [GMV (BRL)], DATEADD ( dim_date[date_day], -1, MONTH ) )
		formatString: #,0.00
		displayFolder: Sales
		lineageTag: bfa7e664-e06d-5e94-9de1-36f45e7486b7

	/// Month-over-month GMV growth; blank unless one month is selected and both it and the previous month are complete (Aug 2018 is partial).
	measure 'GMV MoM Growth %' = ```
			VAR IsOneMonth = HASONEVALUE ( dim_date[year_month] )
			VAR CurrentComplete = SELECTEDVALUE ( dim_date[is_complete_month_in_window] )
			VAR PreviousComplete =
			    CALCULATE (
			        SELECTEDVALUE ( dim_date[is_complete_month_in_window] ),
			        DATEADD ( dim_date[date_day], -1, MONTH )
			    )
			VAR Previous = [GMV Previous Month (BRL)]
			RETURN
			    IF (
			        IsOneMonth && CurrentComplete = TRUE () && PreviousComplete = TRUE (),
			        DIVIDE ( [GMV (BRL)] - Previous, Previous )
			    )
			```
		formatString: 0.00%
		displayFolder: Sales
		lineageTag: 29f6df9d-2c1f-5540-b0a6-4d07179c6496

	/// Distinct customer_unique_id with at least one revenue order in context.
	measure Customers = ```
			CALCULATE (
			    DISTINCTCOUNT ( fact_orders[customer_unique_id] ),
			    fact_orders[is_revenue_order] = TRUE (),
			    fact_orders[is_in_analysis_window] = TRUE ()
			)
			```
		formatString: #,0
		displayFolder: Customers
		lineageTag: c2572030-211a-534b-884a-90fd0693ab3f

	/// Customers with 2+ revenue orders within the current filter context.
	measure 'Repeat Customers' = ```
			VAR CustomerOrders =
			    CALCULATETABLE (
			        ADDCOLUMNS (
			            VALUES ( fact_orders[customer_unique_id] ),
			            "@orders", CALCULATE ( COUNTROWS ( fact_orders ) )
			        ),
			        fact_orders[is_revenue_order] = TRUE (),
			        fact_orders[is_in_analysis_window] = TRUE ()
			    )
			RETURN
			    COUNTROWS ( FILTER ( CustomerOrders, [@orders] >= 2 ) )
			```
		formatString: #,0
		displayFolder: Customers
		lineageTag: 334ecdd1-925f-5e40-8f48-227480d87fd6

	/// Repeat customers / customers.
	measure 'Repeat Purchase Rate %' = DIVIDE ( [Repeat Customers], [Customers] )
		formatString: 0.00%
		displayFolder: Customers
		lineageTag: 51fb0888-94ba-55d5-9b7e-b67beb212e14

	/// Revenue orders / customers.
	measure 'Avg Orders per Customer' = DIVIDE ( [Revenue Orders], [Customers] )
		formatString: 0.0000
		displayFolder: Customers
		lineageTag: 0a00e506-75fa-58fc-bca9-0c722c9fae7d

	/// Share of GMV from the top 10% of customers by GMV (ties at the boundary can add customers).
	measure 'Top 10% Customers GMV Share %' = ```
			VAR TopCount = ROUNDUP ( [Customers] * 0.1, 0 )
			VAR CustomerGmv =
			    CALCULATETABLE (
			        ADDCOLUMNS ( VALUES ( fact_orders[customer_unique_id] ), "@gmv", [GMV (BRL)] ),
			        fact_orders[is_revenue_order] = TRUE (),
			        fact_orders[is_in_analysis_window] = TRUE ()
			    )
			VAR TopCustomers = TOPN ( TopCount, CustomerGmv, [@gmv], DESC )
			RETURN
			    DIVIDE ( SUMX ( TopCustomers, [@gmv] ), [GMV (BRL)] )
			```
		formatString: 0.00%
		displayFolder: Customers
		lineageTag: 5f7e6ae4-58ca-5d05-8f38-36fb88661de0

	/// Population for delivery KPIs (BR-07).
	measure 'Delivery-Eligible Orders' = ```
			CALCULATE (
			    COUNTROWS ( fact_orders ),
			    fact_orders[is_delivery_kpi_eligible] = TRUE (),
			    fact_orders[is_in_analysis_window] = TRUE ()
			)
			```
		formatString: #,0
		displayFolder: Operations
		lineageTag: 6e827823-82ac-57d9-8c1f-f1d17e6b84ed

	/// Mean purchase-to-delivery time in days, eligible orders.
	measure 'Avg Delivery Days' = ```
			CALCULATE (
			    AVERAGE ( fact_orders[delivery_days] ),
			    fact_orders[is_delivery_kpi_eligible] = TRUE (),
			    fact_orders[is_in_analysis_window] = TRUE ()
			)
			```
		formatString: 0.00
		displayFolder: Operations
		lineageTag: 99c9b6f7-df6e-590e-8c4c-6d2c0446b8b6

	/// Median purchase-to-delivery time in days, eligible orders.
	measure 'Median Delivery Days' = ```
			CALCULATE (
			    MEDIAN ( fact_orders[delivery_days] ),
			    fact_orders[is_delivery_kpi_eligible] = TRUE (),
			    fact_orders[is_in_analysis_window] = TRUE ()
			)
			```
		formatString: 0.00
		displayFolder: Operations
		lineageTag: 09faef41-e95c-5ed4-8808-7df32c346627

	/// Eligible orders delivered after the estimated date / eligible orders.
	measure 'Late Delivery Rate %' = ```
			DIVIDE (
			    CALCULATE (
			        COUNTROWS ( fact_orders ),
			        fact_orders[is_delivery_kpi_eligible] = TRUE (),
			        fact_orders[is_in_analysis_window] = TRUE (),
			        fact_orders[is_late] = TRUE ()
			    ),
			    [Delivery-Eligible Orders]
			)
			```
		formatString: 0.00%
		displayFolder: Operations
		lineageTag: 89076a8d-2ca7-5b76-b5f6-6c5249339d3e

	/// 1 − late delivery rate (blank without eligible orders).
	measure 'On-Time Delivery Rate %' = IF ( NOT ISBLANK ( [Delivery-Eligible Orders] ), 1 - [Late Delivery Rate %] )
		formatString: 0.00%
		displayFolder: Operations
		lineageTag: 9253468f-3634-5058-8143-74f3b78bdcd1

	/// Orders of any status purchased in the analysis window.
	measure 'All Orders' = CALCULATE ( COUNTROWS ( fact_orders ), fact_orders[is_in_analysis_window] = TRUE () )
		formatString: #,0
		displayFolder: Operations
		lineageTag: b51ff92a-2339-59df-b5d6-ff78693fceec

	/// Orders with status canceled or unavailable / all orders (status at extract time).
	measure 'Cancellation Rate %' = ```
			DIVIDE (
			    CALCULATE (
			        COUNTROWS ( fact_orders ),
			        fact_orders[is_in_analysis_window] = TRUE (),
			        fact_orders[order_status] IN { "canceled", "unavailable" }
			    ),
			    [All Orders]
			)
			```
		formatString: 0.00%
		displayFolder: Operations
		lineageTag: e3843740-48ec-54c4-80f2-6d385bccd1d9

	/// Σ freight / revenue orders.
	measure 'Avg Freight per Order (BRL)' = ```
			DIVIDE (
			    CALCULATE (
			        SUM ( fact_orders[freight_total] ),
			        fact_orders[is_revenue_order] = TRUE (),
			        fact_orders[is_in_analysis_window] = TRUE ()
			    ),
			    [Revenue Orders]
			)
			```
		formatString: #,0.00
		displayFolder: Operations
		lineageTag: 3cd82f66-45a5-5ae0-8de2-d73573df498a

	/// Freight / GMV. A cost-structure proxy, not a margin (no product cost data).
	measure 'Freight Share of GMV % (proxy)' = ```
			DIVIDE (
			    CALCULATE (
			        SUM ( fact_orders[freight_total] ),
			        fact_orders[is_revenue_order] = TRUE (),
			        fact_orders[is_in_analysis_window] = TRUE ()
			    ),
			    [GMV (BRL)]
			)
			```
		formatString: 0.00%
		displayFolder: Profitability proxies
		lineageTag: 660db87d-cc5a-5f4f-9806-a1c7c01c94b0

	/// Mean per-order review score (selected review, BR-06), orders in the window.
	measure 'Avg Review Score' = CALCULATE ( AVERAGE ( fact_orders[review_score] ), fact_orders[is_in_analysis_window] = TRUE () )
		formatString: 0.00
		displayFolder: Operations
		lineageTag: 5e2da3fc-b8f6-5d2f-be7e-2d65ba72ce9e

	/// Orders in the window with a review score.
	measure 'Reviewed Orders' = CALCULATE ( COUNT ( fact_orders[review_score] ), fact_orders[is_in_analysis_window] = TRUE () )
		formatString: #,0
		displayFolder: Operations
		lineageTag: ef415f2b-46fb-59f3-9127-8c2905b020b4

	/// Regional slice check (customer state at order time = SP). Hidden helper for reconciliation.
	measure 'GMV São Paulo check' = CALCULATE ( [GMV (BRL)], fact_orders[customer_state_at_order] = "SP" )
		formatString: #,0.00
		displayFolder: _Checks
		isHidden
		lineageTag: 80768664-25b0-568b-a860-21f6c3e00ff4

