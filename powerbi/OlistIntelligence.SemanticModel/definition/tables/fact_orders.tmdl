	partition fact_orders = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database(PostgresServer, PostgresDatabase),
				    Data = Source{[Schema="marts", Item="fact_orders"]}[Data]
				in
				    Data

	annotation PBI_ResultType = Table
