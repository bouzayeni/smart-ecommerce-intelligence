table fact_order_items
	lineageTag: 27d5155d-4a73-55d4-b53d-4e3702736d1e

	/// Item-level GMV; use for category, product and seller breakdowns.
	measure 'Item GMV (BRL)' = ```
			CALCULATE (
			    SUM ( fact_order_items[gmv] ),
			    fact_order_items[is_revenue_order] = TRUE (),
			    fact_order_items[is_in_analysis_window] = TRUE ()
			)
			```
		formatString: #,0.00
		displayFolder: Sales
		lineageTag: ddcc2a78-5eed-5f86-8034-c21b119cb00c

	/// Item rows (one row = one unit, BR-05) of revenue orders in the window.
	measure 'Units Sold' = ```
			CALCULATE (
			    COUNTROWS ( fact_order_items ),
			    fact_order_items[is_revenue_order] = TRUE (),
			    fact_order_items[is_in_analysis_window] = TRUE ()
			)
			```
		formatString: #,0
		displayFolder: Sales
		lineageTag: 364b6758-3fc0-5d21-871c-5d81167ce8f7

	/// Item GMV in the current context / item GMV across all categories.
	measure 'Category Share of GMV %' = DIVIDE ( [Item GMV (BRL)], CALCULATE ( [Item GMV (BRL)], REMOVEFILTERS ( dim_products ) ) )
		formatString: 0.00%
		displayFolder: Sales
		lineageTag: 08d50f94-2e6b-5e7e-a51f-a23345bdd7aa

	/// Rank of the product in context by item GMV (1 = top); blank without a single product.
	measure 'Product GMV Rank' = ```
			IF (
			    HASONEVALUE ( dim_products[product_id] ) && NOT ISBLANK ( [Item GMV (BRL)] ),
			    RANKX ( ALL ( dim_products[product_id] ), [Item GMV (BRL)], , DESC, SKIP )
			)
			```
		formatString: #,0
		displayFolder: Sales
		lineageTag: 18c91905-6338-511d-9b53-b59cee42fa65

